# Copy to backend/.env and fill in. Never commit the real file.

# Required for AI processing (Google AI Studio)
GOOGLE_API_KEY=

# Optional: override the default model when Google retires it
# GEMINI_MODEL=gemini-3.5-flash

# Required for saving maps (Supabase project settings)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated list of allowed frontend origins
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
